# Required when REQUIRE_INVITE is true (the secure default).
INVITE_CODE=replace-with-a-long-random-value

# Optional. If omitted, the server returns a deterministic local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional comma-separated browser origins. Leave unset for same-origin use.
CORS_ORIGIN=

# Set to false only for a local, non-public demo.
REQUIRE_INVITE=true
PORT=3001
